# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every setting below is read by app/core/config.py.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
SECRET_KEY=change-me-in-production

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Scraping -------------------------------------------------------------
SCRAPE_HTTP_TIMEOUT_SECONDS=20
SCRAPE_RENDER_TIMEOUT_SECONDS=45
SCRAPE_MAX_RETRIES=3
SCRAPE_BACKOFF_BASE_SECONDS=2.0
SCRAPE_MAX_CONCURRENCY=8
SCRAPE_RESPECT_ROBOTS=true
SCRAPE_REQUESTS_PER_MINUTE_PER_DOMAIN=20
SCRAPE_ROTATE_USER_AGENTS=true
# Comma-separated, e.g. http://user:pass@proxy:8080,http://proxy2:8080
SCRAPE_PROXIES=
SCRAPE_MAX_CONSECUTIVE_FAILURES=10

# --- Playwright -----------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_WAIT_UNTIL=networkidle
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_BLOCK_RESOURCES=image,media,font

# --- Extraction -----------------------------------------------------------
EXTRACTION_MIN_CONFIDENCE=0.6
EXTRACTION_MIN_JOBS_EXPECTED=1
SELECTOR_REGENERATE_AFTER_FAILURES=3
SELECTOR_MAX_VERSIONS_RETAINED=10

# --- LLM ------------------------------------------------------------------
# Provider: openai | anthropic | gemini | null   ("null" disables tier 5)
#
# Gemini is the default because its free tier is real. Get a key at
# https://aistudio.google.com/apikey and paste it into GEMINI_API_KEY below.
# Run `python scripts/check_llm.py` afterwards to confirm the key works and to
# list the models it can actually reach.
#
# On a free key the binding limit is requests per day, not dollars, so
# LLM_DAILY_BUDGET_USD acts purely as a local safety net.
#
# Do not use a gemini-2.5-* model on a new key. Google gates those to
# pre-existing users ahead of their 2026-10-16 shutdown, so they still appear
# in models.list() but 404 on the first real call. `make check-llm` verifies
# callability (not just listing) and names a working model if this one fails.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview
LLM_ENABLED=true
LLM_MAX_INPUT_CHARS=24000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TEMPERATURE=0.0
LLM_DAILY_BUDGET_USD=5.0
LLM_BUDGET_BREAKER_ENABLED=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Matching -------------------------------------------------------------
MATCH_THRESHOLD=0.6
MATCH_SEMANTIC_ENABLED=true
MATCH_SEMANTIC_MAX_JOBS_PER_RUN=25

# --- Notifications --------------------------------------------------------
NOTIFY_CHANNELS=email
NOTIFY_FROM_EMAIL=jobs@example.com

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduler ------------------------------------------------------------
SCHEDULER_TICK_MINUTES=5
SCHEDULER_DEFAULT_INTERVAL_MINUTES=1440
